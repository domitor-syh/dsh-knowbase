# 统一行尾，避免 Windows / Linux 之间的换行符抖动
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做文本处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary

# Frozen benchmark inputs/results carry exact SHA-256 hashes; preserve bytes.
outputs/retrieval-baseline-repro/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
outputs/retrieval-quality-before.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
outputs/retrieval-quality-after.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
