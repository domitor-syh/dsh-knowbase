# Generated benchmark reports and private development notes
outputs/
HANDOFF.md
dev.patch.yml
.cleanup-*.mjs

# 依赖与构建产物
node_modules/
dist/
build/
out/
lib/
*.tsbuildinfo
*.tgz
*.tgz.bak

# 注意：pnpm-workspace.yaml 必须入库。pnpm 11 把构建脚本授权（allowBuilds）放在
# 那里，且要求显式 true/false，留占位符会导致全新克隆上的安装直接失败。

# 本地助手工作数据（记忆、会话状态），非项目源码
.workbuddy-ai/

# 隔离的 DSH 开发环境（DSH_HOME），用于不污染 ~/.dsh 的真机加载验证
.dshdev/

# 第二个隔离 DSH_HOME：专门用来验「全新用户首装」（空库 + 空 .ocr/ + 全新 profile）。
# 与 .dshdev 分开是因为首装验收要的是「什么都没有」的初始态，而 .dshdev 里已经有库和语言包。
.dshfresh/

# 环境与凭据
.env
.env.*
!.env.example
*.pem
*.key

# 日志与临时文件
*.log
logs/
tmp/
temp/
*.tmp

# 真机验证用的临时抓取物（宿主页面、插槽清单、带 token 的 URL、cookie）。
# 全部可由 HANDOFF §5/§14 的命令重新生成，且 .kb-url.txt / .kb-cookies.txt 含 token。
.kb-*

# 测试与覆盖率
coverage/
.nyc_output/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
