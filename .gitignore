# 依赖与构建产物
node_modules/
dist/
build/
out/
lib/
*.tsbuildinfo
*.tgz
*.tgz.bak

# pnpm 11 每次安装都会重写这个占位文件（内容只是「设为 true 或 false」的提示），
# 它是噪声而非配置
pnpm-workspace.yaml

# 本地助手工作数据（记忆、会话状态），非项目源码
.workbuddy-ai/

# 隔离的 DSH 开发环境（DSH_HOME），用于不污染 ~/.dsh 的真机加载验证
.dshdev/

# 环境与凭据
.env
.env.*
!.env.example
*.pem
*.key

# 日志与临时文件
*.log
logs/
tmp/
temp/
*.tmp

# 测试与覆盖率
coverage/
.nyc_output/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
