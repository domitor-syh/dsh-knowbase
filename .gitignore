# 依赖与构建产物
node_modules/
dist/
build/
out/
lib/
*.tsbuildinfo
*.tgz
*.tgz.bak

# 注意：pnpm-workspace.yaml 必须入库。pnpm 11 把构建脚本授权（allowBuilds）放在
# 那里，且要求显式 true/false，留占位符会导致全新克隆上的安装直接失败。

# 本地助手工作数据（记忆、会话状态），非项目源码
.workbuddy-ai/

# 隔离的 DSH 开发环境（DSH_HOME），用于不污染 ~/.dsh 的真机加载验证
.dshdev/

# 环境与凭据
.env
.env.*
!.env.example
*.pem
*.key

# 日志与临时文件
*.log
logs/
tmp/
temp/
*.tmp

# 测试与覆盖率
coverage/
.nyc_output/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
