{
  "name": "@domitor-syh/dsh-knowbase",
  "description": "Native, local-first knowledge base for DeepSeek Harness: ingest local documents, retrieve with Chinese n-gram/BM25, and answer with citations",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:ci-locale": "vitest run --config scripts/vitest.ci-locale.config.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test:docs": "node --test scripts/check-docs.cases.mjs",
    "benchmark:retrieval": "node --experimental-strip-types scripts/benchmark-retrieval.ts",
    "verify": "node scripts/verify-bundles.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domitor-syh/dsh-knowbase.git"
  },
  "homepage": "https://github.com/domitor-syh/dsh-knowbase#readme",
  "bugs": {
    "url": "https://github.com/domitor-syh/dsh-knowbase/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "knowledge-base",
    "rag",
    "retrieval",
    "bm25",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-resources": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/ocr-runtime.cjs",
    "lib/ocr-worker.cjs",
    "lib/tesseract-core.wasm",
    "lib/tesseract-core-simd.wasm",
    "lib/tesseract-core-relaxedsimd.wasm",
    "lib/THIRD-PARTY-LICENSE-tesseract.txt",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.5"
  }
}
